{
  "ssotVersion": "1.0.0",
  "project": {
    "id": "core-lottery-generator",
    "name": "Core Lottery Generator",
    "description": "Here is a list of the features I want Core Lottery Generator to have:\r\n\r\n1. user selects which Illinois lottery game to generate numbers for\r\n2. user will select how many tickets to generate number for\r\n3. user clicks \u0022Generate\u0022\r\n\r\nAgent can grab the rules for all Illinois Lottery games (listed below) and cache them:\r\n\r\n1. Power Ball\r\n2. Mega Millions\r\n3. Lotto\r\n4. Lucky Day Lotto\r\n5. Pick 3\r\n6. Pick 4\r\n\r\nAgent is free to implement the above listed description items in the best way they see fit.  The Agent may ask if they need clarification on any of the build details.",
    "owner": "",
    "tags": [
      "wpf-desktop"
    ]
  },
  "environment": {
    "targetOs": "Windows 11",
    "runtime": ".NET 8",
    "uiFramework": "WPF",
    "language": "C#"
  },
  "architecture": {
    "pattern": "MVVM",
    "layers": [
      "UI",
      "Application",
      "Domain",
      "Infrastructure"
    ],
    "modules": [
      {
        "name": "AppShell",
        "description": "Application entry and navigation shell.",
        "dependencies": []
      },
      {
        "name": "CoreLogic",
        "description": "Main product behavior.",
        "dependencies": [
          "AppShell"
        ]
      }
    ]
  },
  "ui": {
    "theme": "Default",
    "navigationPattern": "Window\u002BDialogs",
    "screens": [
      {
        "id": "main",
        "title": "Generate Your Winning Lotto Numbers",
        "route": "/",
        "controls": [
          {
            "id": "gamePicker",
            "type": "ComboBox",
            "label": "Illinois Lottery game",
            "action": "SelectOption"
          },
          {
            "id": "ticketCount",
            "type": "TextBox",
            "label": "Ticket Count",
            "action": "SetTicketCount"
          },
          {
            "id": "generateButton",
            "type": "Button",
            "label": "Generate",
            "action": "GenerateResults"
          },
          {
            "id": "resultsList",
            "type": "ListView",
            "label": "Ticket results",
            "action": "ViewResults"
          }
        ]
      },
      {
        "id": "history",
        "title": "History",
        "route": "/history",
        "controls": [
          {
            "id": "historyList",
            "type": "ListView",
            "label": "Past results",
            "action": "ViewHistory"
          },
          {
            "id": "saveButton",
            "type": "Button",
            "label": "Save",
            "action": "SaveHistory"
          }
        ]
      },
      {
        "id": "settings",
        "title": "Settings",
        "route": "/settings",
        "controls": [
          {
            "id": "settingsSaveButton",
            "type": "Button",
            "label": "Save settings",
            "action": "SaveSettings"
          }
        ]
      }
    ]
  },
  "domain": {
    "entities": [
      {
        "name": "OptionChoice",
        "description": "A selectable option the user can pick.",
        "fields": [
          {
            "name": "Id",
            "type": "string",
            "required": true
          },
          {
            "name": "Label",
            "type": "string",
            "required": true
          },
          {
            "name": "IsSelected",
            "type": "bool",
            "required": false
          }
        ]
      },
      {
        "name": "UserInput",
        "description": "Values the user types on screen (counts, names, notes).",
        "fields": [
          {
            "name": "FieldName",
            "type": "string",
            "required": true
          },
          {
            "name": "Value",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "name": "ResultItem",
        "description": "A generated or listed result shown to the user.",
        "fields": [
          {
            "name": "Id",
            "type": "Guid",
            "required": true
          },
          {
            "name": "DisplayText",
            "type": "string",
            "required": true
          },
          {
            "name": "CreatedAt",
            "type": "DateTime",
            "required": true
          }
        ]
      },
      {
        "name": "HistoryEntry",
        "description": "A saved record from a previous run.",
        "fields": [
          {
            "name": "Id",
            "type": "Guid",
            "required": true
          },
          {
            "name": "Summary",
            "type": "string",
            "required": true
          },
          {
            "name": "SavedAt",
            "type": "DateTime",
            "required": true
          }
        ]
      },
      {
        "name": "AppSettings",
        "description": "User preferences for the application.",
        "fields": [
          {
            "name": "ThemePreference",
            "type": "string",
            "required": false
          },
          {
            "name": "LastUsedOption",
            "type": "string",
            "required": false
          }
        ]
      }
    ]
  },
  "workflows": [
    {
      "id": "generatebutton",
      "name": "Generate",
      "trigger": "generateButton",
      "steps": [
        "Read the selected lottery game",
        "Read the ticket count",
        "Create that many tickets using the game\u2019s number rules",
        "Show the tickets in the results list"
      ],
      "errorHandling": {
        "strategy": "ShowMessageBox",
        "logLevel": "Warning"
      }
    },
    {
      "id": "savebutton",
      "name": "Save",
      "trigger": "saveButton",
      "steps": [
        "Collect the current result",
        "Store it using the chosen memory setting",
        "Confirm it was saved"
      ],
      "errorHandling": {
        "strategy": "ShowMessageBox",
        "logLevel": "Warning"
      }
    },
    {
      "id": "settingssavebutton",
      "name": "Save settings",
      "trigger": "settingsSaveButton",
      "steps": [
        "Collect the current result",
        "Store it using the chosen memory setting",
        "Confirm it was saved"
      ],
      "errorHandling": {
        "strategy": "ShowMessageBox",
        "logLevel": "Warning"
      }
    }
  ],
  "constraints": {
    "allowedLibraries": [
      "CommunityToolkit.Mvvm",
      "Microsoft.Extensions.DependencyInjection"
    ],
    "forbiddenLibraries": [],
    "loggingRequired": true,
    "telemetryAllowed": false,
    "thirdPartyBootloadersAllowed": false
  },
  "data": {
    "storage": {
      "type": "LocalJson",
      "connectionStringMode": "None",
      "migrationsRequired": false
    }
  },
  "build": {
    "outputType": "WinExe",
    "configuration": [
      "Debug",
      "Release"
    ],
    "targets": [
      {
        "name": "win-x64",
        "runtimeIdentifier": "win-x64"
      }
    ]
  },
  "deployment": {
    "packaging": "None",
    "autoUpdate": false
  },
  "testing": {
    "unitTestFramework": "xUnit",
    "uiTestFramework": "FlaUI",
    "coverageTarget": 0.6
  },
  "documentation": {
    "generateReadme": true,
    "generateArchitectureDoc": true,
    "sections": [
      "Overview",
      "Architecture",
      "Workflows",
      "Entities"
    ]
  }
}