<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Application Packaging Project for Core AI Architect.
  Requires Visual Studio workload: .NET desktop development with MSIX Packaging Tools,
  and/or Universal Windows Platform development.
  See: https://learn.microsoft.com/en-us/windows/msix/desktop/desktop-to-uwp-packaging-dot-net
-->
<Project ToolsVersion="15.0"
         DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="Globals">
    <ProjectGuid>B8E4C1A2-7D3F-4A91-9E2C-5F6B8D0A1C44</ProjectGuid>
    <ProjectName>CoreAiArchitect.Package</ProjectName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)CoreAiArchitect.Package.props" Condition="Exists('$(MSBuildThisFileDirectory)CoreAiArchitect.Package.props')" />

  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <EntryPointProjectUniqueName>..\CoreAiArchitect.App\CoreAiArchitect.App.csproj</EntryPointProjectUniqueName>
    <AssetTargetFallback>net8.0-windows$(AssetTargetFallback);</AssetTargetFallback>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AppxPackage>Always</AppxPackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AppxPackage>Always</AppxPackage>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <!-- Use Core-AI-Architect artwork for all MSIX logos/tiles -->
    <Content Include="..\..\Assets\Core-AI-Architect-icon1024.1024.png" Link="Images\StoreLogo.png" />
    <Content Include="..\..\Assets\Core-AI-Architect-icon1024.1024.png" Link="Images\Square150x150Logo.png" />
    <Content Include="..\..\Assets\Core-AI-Architect-icon-256.png" Link="Images\Square44x44Logo.png" />
    <Content Include="..\..\Assets\Core-AI-Architect-icon1024.1024.png" Link="Images\Wide310x150Logo.png" />
    <Content Include="..\..\Assets\Core-AI-Architect-icon1024.1024.png" Link="Images\SplashScreen.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreAiArchitect.App\CoreAiArchitect.App.csproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
      <PublishProfile>Properties\PublishProfiles\Win32.pubxml</PublishProfile>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.props')" />
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.targets')" />

  <!-- Fallback message when WAP tooling is not installed (dotnet CLI builds). -->
  <Target Name="WarnIfWapMissing" BeforeTargets="Build" Condition="!Exists('$(WapProjPath)\Microsoft.DesktopBridge.targets')">
    <Warning Text="MSIX packaging targets were not found. Open CoreAiArchitect.Package.wapproj in Visual Studio with MSIX Packaging Tools installed to produce the package. The desktop app and other projects still build via dotnet CLI." />
  </Target>

</Project>
