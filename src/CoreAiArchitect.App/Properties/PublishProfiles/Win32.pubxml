<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent publish used by the Windows Application Packaging (MSIX) project.
  Prefer the self-contained Win64-SelfContained profile for day-to-day running.

  Output:
    artifacts/CoreAiArchitect-fd/
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>$(CoreAiArchitectFrameworkDependentPublishDir)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
