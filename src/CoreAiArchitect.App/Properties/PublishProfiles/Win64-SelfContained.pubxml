<?xml version="1.0" encoding="utf-8"?>
<!--
  Double-clickable Windows x64 build. Includes the .NET 8 desktop runtime
  so the app can open without a separate runtime install.

  Output always goes to the repo-canonical folder:
    artifacts/CoreAiArchitect/
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>$(CoreAiArchitectPublishDir)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
