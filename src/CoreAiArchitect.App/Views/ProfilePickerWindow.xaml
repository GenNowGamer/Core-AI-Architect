<Window x:Class="CoreAiArchitect.App.Views.ProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Form Profile"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Choose a form profile for the SSOT document." Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Cancel" Width="88" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>
    <ListBox x:Name="ProfileList" MouseDoubleClick="ProfileList_OnMouseDoubleClick"/>
  </DockPanel>
</Window>
