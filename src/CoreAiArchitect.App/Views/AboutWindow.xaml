<Window x:Class="CoreAiArchitect.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Core AI Architect"
        Width="480" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SandBrush}"
        Foreground="{DynamicResource InkBrush}">
  <Border Padding="24">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Close" Click="Close_Click" Style="{DynamicResource PrimaryButton}" Padding="20,8" IsDefault="True"/>
      </StackPanel>

      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Core AI Architect" FontFamily="{StaticResource DisplayFont}"
                     FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TealBrush}"
                     VerticalAlignment="Center"/>
          <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="10"
                  Background="{DynamicResource InnerCardBackgroundBrush}"
                  BorderBrush="{DynamicResource TealBrush}" BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock x:Name="VersionBadgeText" Text="v1.1.0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TealBrush}"/>
          </Border>
        </StackPanel>

        <TextBlock Text="Canonical App Blueprint (SSOT) authoring tool for AI coding agents."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>

        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Application Version" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionText" Text="1.1.0" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="SSOT Schema" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SchemaVersionText" Text="1.1.0" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Coresynth Studios" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Runtime" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text=".NET 8 / Windows WPF" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="License" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="MIT License" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Privacy" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="100% Local — Zero Telemetry"/>
          </Grid>
        </Border>

        <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
          <Run Text="Repository: "/>
          <Hyperlink NavigateUri="https://github.com/GenNowGamer/Core-AI-Architect"
                     RequestNavigate="Hyperlink_RequestNavigate"
                     Foreground="{DynamicResource TealBrush}">
            https://github.com/GenNowGamer/Core-AI-Architect
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
