<Window x:Class="CoreAiArchitect.App.Views.HelpTopicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="480" Width="560"
        MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right"
            MinWidth="88" Padding="12,6" Margin="0,12,0,0" IsDefault="True" IsCancel="True"
            Click="Close_Click"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="#333333"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="DetailsText" TextWrapping="Wrap" LineHeight="20"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
