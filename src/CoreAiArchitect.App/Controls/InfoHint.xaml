<UserControl x:Class="CoreAiArchitect.App.Controls.InfoHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Button x:Name="InfoButton"
          Content="i"
          Width="18" Height="18"
          Padding="0"
          Margin="6,0,0,0"
          FontSize="11"
          FontWeight="SemiBold"
          FontStyle="Italic"
          Cursor="Hand"
          VerticalAlignment="Center"
          ToolTipService.ShowDuration="20000"
          Click="InfoButton_OnClick"
          PreviewKeyDown="InfoButton_OnPreviewKeyDown">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Grid>
          <Ellipse x:Name="Bg" Fill="#E8EEF5" Stroke="#5B7C9D" StrokeThickness="1"/>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Bg" Property="Fill" Value="#D5E4F5"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Bg" Property="Fill" Value="#C2D7EE"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>
  </Button>
</UserControl>
