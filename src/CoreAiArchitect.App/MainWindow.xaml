<Window x:Class="CoreAiArchitect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CoreAiArchitect.App.Converters"
        xmlns:ctrl="clr-namespace:CoreAiArchitect.App.Controls"
        Title="{Binding WindowTitle}"
        Height="840" Width="1220"
        MinHeight="660" MinWidth="1020"
        Background="{DynamicResource SandBrush}"
        Foreground="{DynamicResource InkBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <conv:WizardStepVisibilityConverter x:Key="StepVis"/>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:DetailLevelVisibilityConverter x:Key="DetailVis"/>
    <conv:HubStatusBrushConverter x:Key="HubStatusBrush"/>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
  </Window.InputBindings>

  <Border BorderThickness="1" BorderBrush="{DynamicResource OuterBorderBrush}" Background="{DynamicResource SandBrush}">
  <DockPanel Background="{DynamicResource SandBrush}">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New app blueprint" Command="{Binding NewDocumentCommand}"/>
        <MenuItem Header="_Open..." Command="{Binding OpenDocumentCommand}"/>
        <MenuItem Header="_Recent Blueprints" ItemsSource="{Binding RecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding}"/>
              <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
              <Setter Property="CommandParameter" Value="{Binding}"/>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <MenuItem Header="_Save" Command="{Binding SaveDocumentCommand}"/>
        <MenuItem Header="Save _As..." Command="{Binding SaveDocumentAsCommand}"/>
        <Separator/>
        <MenuItem Header="Export for _AI agent..." Command="{Binding ExportJsonCommand}"/>
        <MenuItem Header="Export _Agent Package..." Command="{Binding ExportAgentPackageCommand}"/>
        <MenuItem Header="Export _Markdown..." Command="{Binding ExportMarkdownCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_How this works" Command="{Binding ShowHelpCommand}"/>
        <Separator/>
        <MenuItem Header="_About Core AI Architect" Command="{Binding ShowAboutCommand}"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderGradient}" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Core AI Architect" FontFamily="{StaticResource DisplayFont}"
                       FontSize="28" FontWeight="SemiBold" Foreground="White"/>
            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10"
                    Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#EAF6F5"/>
            </Border>
          </StackPanel>
          <TextBlock Text="Describe what you want — we turn it into a validated App Blueprint for an AI coding agent."
                     Foreground="#F7EDE8" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Left" Content="🌓 Theme" Command="{Binding ToggleDarkModeCommand}"
                    Style="{DynamicResource GhostButton}" Padding="8,2" Foreground="White" FontSize="11"
                    ToolTip="Toggle between Light and Dark mode"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="White" HorizontalAlignment="Right"
                       TextWrapping="Wrap" TextAlignment="Right"/>
          </DockPanel>
          <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                       Foreground="{StaticResource CoralBrush}" Background="#66FFFFFF"/>
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SandDeepBrush}">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" Margin="8,0"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding AppVersionDisplay, StringFormat=Core AI Architect {0}}"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0"/>
      </StatusBarItem>
    </StatusBar>

    <Border Margin="24" Style="{DynamicResource WizardCard}" Padding="28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <ItemsControl ItemsSource="{Binding StepItems}" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.NavigateToStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Step}"
                        Cursor="Hand" Margin="0,0,6,0" Padding="8,6">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Background" Value="{DynamicResource InnerCardBackgroundBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource TealBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource CoralBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource CoralBrush}"/>
                          <Setter Property="Foreground" Value="White"/>
                          <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RequirementTag}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" Opacity="0.8" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding StepTitle}" FontFamily="{StaticResource DisplayFont}"
                     FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TealBrush}"/>
          <TextBlock Text="{Binding StepSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button Content="Back" Command="{Binding BackCommand}" Style="{DynamicResource GhostButton}"
                  Margin="0,0,10,0" IsEnabled="{Binding CanGoBack}"/>
          <Button Content="Next" Command="{Binding NextCommand}" Style="{DynamicResource PrimaryButton}"
                  Visibility="{Binding CanGoNext, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <!-- Ad-Lib (Your idea) -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVis}, ConverterParameter=YourIdea}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="What kind of app?"/>
                <Border Style="{DynamicResource RequiredBadge}"><TextBlock Style="{DynamicResource RequiredBadgeText}"/></Border>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding AppKinds}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,12,0" Padding="14" CornerRadius="10" Cursor="Hand"
                            MouseLeftButtonUp="AppKindCard_OnClick" Tag="{Binding}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource InnerCardBackgroundBrush}"/>
                              <Setter Property="BorderBrush" Value="{DynamicResource CoralBrush}"/>
                              <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TealBrush}"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Background="{DynamicResource InnerCardBackgroundBrush}" BorderBrush="{DynamicResource InnerCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Guided Ad-Lib" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TealBrush}" VerticalAlignment="Center"/>
                    <Border Style="{DynamicResource RequiredBadge}"><TextBlock Style="{DynamicResource RequiredBadgeText}" Text="Required (Name + Purpose)"/></Border>
                  </StackPanel>

                  <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="I'm building an app called " VerticalAlignment="Center" FontSize="15"/>
                    <TextBox Text="{Binding Answers.ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" Margin="4,0,4,0" FontSize="15"/>
                    <TextBlock Text="." VerticalAlignment="Center" FontSize="15"/>
                    <Border Style="{DynamicResource RequiredBadge}"><TextBlock Style="{DynamicResource RequiredBadgeText}"/></Border>
                  </WrapPanel>

                  <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="It's mainly for " VerticalAlignment="Center" FontSize="15"/>
                    <TextBox Text="{Binding Answers.Audience, UpdateSourceTrigger=PropertyChanged}"
                             Width="320" Margin="4,0,4,0" FontSize="15"
                             ToolTip="e.g. PC gamers, small shop owners, me"/>
                    <TextBlock Text="." VerticalAlignment="Center" FontSize="15"/>
                  </WrapPanel>

                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="It will help them…" FontSize="15" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Answers.HelpsThem, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" MinHeight="44" FontSize="15"
                             ToolTip="e.g. manage and back up game save files"/>
                  </StackPanel>

                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="The main things users should be able to do are:" FontSize="15" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Answers.FeatureListText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" FontSize="14"
                             ToolTip="One capability per line. On a blank template these become starter buttons."/>
                    <TextBlock Text="One per line — on a blank start these become buttons on your first screen."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                  </StackPanel>

                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="My app will mainly be used…" FontSize="14" VerticalAlignment="Center"/>
                        <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding ConnectivityOptions}"
                                SelectedItem="{Binding SelectedConnectivityLabel}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="The interface should feel…" FontSize="14" VerticalAlignment="Center"/>
                        <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding LookStyleOptions}"
                                SelectedItem="{Binding Answers.LookStyle}" FontSize="14"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="Product rules"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <TextBlock Text="{Binding DescriptionGuidance}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
              <TextBox Text="{Binding Answers.ProductRules, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Margin="0,0,0,8"
                       LostFocus="Description_OnLostFocus"/>
              <Button Content="Get tips from my description" Command="{Binding RefreshTipsCommand}"
                      Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="12,6"/>
              <ItemsControl ItemsSource="{Binding DescriptionTips}" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TealBrush}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="Start from a template"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Cursor="Hand"
                            MouseLeftButtonUp="TemplateCard_OnClick" Tag="{Binding}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                              <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- What you need (gap questions) -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVis}, ConverterParameter=WhatYouNeed}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="Will different people have their own accounts?"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <ComboBox ItemsSource="{Binding AccountsOptions}" SelectedItem="{Binding SelectedAccountsLabel}"
                        Margin="0,0,0,6" FontSize="14"/>
              <TextBlock Text="{Binding AccountsHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" FontSize="12"/>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="Should information follow the user between devices?"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <ComboBox ItemsSource="{Binding MultiDeviceOptions}" SelectedItem="{Binding SelectedMultiDeviceLabel}"
                        Margin="0,0,0,16" FontSize="14"/>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="Should your app remind or notify users about anything?"
                          IsChecked="{Binding Notifications}" Margin="0" FontSize="15"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <StackPanel Visibility="{Binding ShowNotificationNotes, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                <TextBlock Style="{DynamicResource FieldLabel}" Text="What should it remind them about?"/>
                <TextBox Text="{Binding Answers.NotificationNotes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="These answers update your blueprint requirements and description. Technical stack choices stay on Recommended unless you change them later in Expert detail."/>
            </StackPanel>

            <!-- Screens -->
            <DockPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVis}, ConverterParameter=Screens}">
              <!-- Top Horizontal Screen Tab Strip -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,14" Padding="0,0,0,10"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀" Command="{Binding MoveScreenUpCommand}" Style="{DynamicResource GhostButton}"
                            Padding="8,4" Margin="0,0,4,0" ToolTip="Move screen left"/>
                    <Button Content="▶" Command="{Binding MoveScreenDownCommand}" Style="{DynamicResource GhostButton}"
                            Padding="8,4" Margin="0,0,8,0" ToolTip="Move screen right"/>
                    <Button Content="{Binding AddScreenButtonLabel, StringFormat=+ {0}}" Command="{Binding AddScreenCommand}"
                            Style="{DynamicResource SecondaryButton}" Padding="12,6"/>
                  </StackPanel>

                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ScreensGroupHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Style="{DynamicResource RequiredBadge}"><TextBlock Style="{DynamicResource RequiredBadgeText}"/></Border>
                  </StackPanel>

                  <ListBox ItemsSource="{Binding ReviewScreens}" SelectedItem="{Binding SelectedScreen}"
                           BorderThickness="0" Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="TabBd" Background="{DynamicResource InnerCardBackgroundBrush}"
                                      BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                      BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                  <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                  <Setter TargetName="TabBd" Property="BorderThickness" Value="1,1,1,3"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding ScreenType, StringFormat= ({0})}" FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                          <Button Content="✕" FontSize="10" Padding="4,1" Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                                  ToolTip="Remove this screen"
                                  Command="{Binding DataContext.RemoveSpecificScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <!-- 55 / 45 Two-Column Split -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.22*"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Editor Column -->
                <StackPanel Grid.Column="0">
                  <!-- Screen Name + Type -->
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="{Binding ScreenTitleLabel}"/>
                      <TextBox Text="{Binding SelectedScreen.Title, UpdateSourceTrigger=PropertyChanged}" TextChanged="WireframeField_OnTextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="{Binding ScreenTypeLabel}"/>
                        <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding ScreenTypeOptions}" SelectedItem="{Binding SelectedScreen.ScreenType}" SelectionChanged="WireframeField_OnSelectionChanged"/>
                    </StackPanel>
                  </Grid>

                  <!-- 4-Card Visual Element Palette -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding AddThingSectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Style="{DynamicResource RequiredBadge}"><TextBlock Style="{DynamicResource RequiredBadgeText}" Text="Required (min 1)"/></Border>
                  </StackPanel>
                  <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Button Command="{Binding AddButtonThingCommand}" Margin="0,0,8,0" Padding="10,10" Cursor="Hand"
                            ToolTip="Something people click to do work">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InnerCardBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CoralBrush}"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="▶" FontSize="16" Foreground="{DynamicResource CoralBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ButtonThingLabel}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Action to click" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <Button Command="{Binding AddPlaceToTypeCommand}" Margin="0,0,8,0" Padding="10,10" Cursor="Hand"
                            ToolTip="A box for numbers or text">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InnerCardBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✎" FontSize="16" Foreground="{DynamicResource TealBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Text Input" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Type text/numbers" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <Button Command="{Binding AddChoiceListCommand}" Margin="0,0,8,0" Padding="10,10" Cursor="Hand"
                            ToolTip="Let people pick one option">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InnerCardBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="▾" FontSize="16" Foreground="{DynamicResource TealBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Dropdown" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pick one option" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <Button Command="{Binding AddResultsListCommand}" Padding="10,10" Cursor="Hand"
                            ToolTip="Show generated or saved items">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InnerCardBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource InnerCardBorderBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☰" FontSize="16" Foreground="{DynamicResource TealBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Results List" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Show items" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </UniformGrid>

                  <!-- Compact Element Card List -->
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Elements on this Screen" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScreenCaption}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                  </DockPanel>
                  <ListBox ItemsSource="{Binding ReviewControls}" SelectedItem="{Binding SelectedControl}"
                           MinHeight="110" MaxHeight="220" Margin="0,0,0,12"
                           Background="Transparent" BorderThickness="0"
                           SelectionChanged="Review_OnChanged"
                           HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="RowBd" Background="{DynamicResource InnerCardBackgroundBrush}"
                                      BorderBrush="{DynamicResource InnerCardBorderBrush}"
                                      BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                  <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                  <Setter TargetName="RowBd" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▲" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                    Style="{DynamicResource GhostButton}" ToolTip="Move up"
                                    Command="{Binding DataContext.MoveSpecificControlUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="▼" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                    Style="{DynamicResource GhostButton}" ToolTip="Move down"
                                    Command="{Binding DataContext.MoveSpecificControlDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="✕" FontSize="10" Padding="6,2"
                                    Style="{DynamicResource GhostButton}" ToolTip="Remove element"
                                    Command="{Binding DataContext.RemoveSpecificControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource TealBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4"
                                    Background="{DynamicResource SandDeepBrush}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Type, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- Compact Selected Element Editor -->
                  <Border Background="{DynamicResource InnerCardBackgroundBrush}" BorderBrush="{DynamicResource InnerCardBorderBrush}"
                          BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="▸ Advanced (Internal ID)"
                                Command="{Binding ToggleAdvancedControlIdCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource TealBrush}" FontSize="11" Padding="0"/>
                        <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="Selected Element Label"/>
                      </DockPanel>
                      <TextBox Text="{Binding SelectedControl.Label, UpdateSourceTrigger=PropertyChanged}" TextChanged="WireframeField_OnTextChanged"/>
                      <StackPanel Visibility="{Binding ShowAdvancedControlId, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="Internal id (advanced)"/>
                          <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
                        </StackPanel>
                        <TextBox Text="{Binding SelectedControl.Id, UpdateSourceTrigger=PropertyChanged}" TextChanged="WireframeField_OnTextChanged"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Right Live Preview Column (45%) -->
                <DockPanel Grid.Column="2">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Live Preview" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" (click any item to edit)" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ctrl:WireframePreviewControl Screen="{Binding SelectedScreen}"
                                                ProfileId="{Binding Answers.ProfileId}"
                                                SelectedControl="{Binding SelectedControl, Mode=TwoWay}"
                                                RefreshVersion="{Binding WireframeRefreshVersion}"/>
                </DockPanel>
              </Grid>
            </DockPanel>

            <!-- When they click -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVis}, ConverterParameter=WhenTheyClick}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ClicksListHeading}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding ClickFlows}" SelectedItem="{Binding SelectedClickFlow}" DisplayMemberPath="ButtonLabel"/>
              </DockPanel>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Style="{DynamicResource FieldLabel}" Margin="0" Text="{Binding ClicksFlowQuestion}"/>
                  <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
                </StackPanel>
                <TextBlock Text="{Binding ClicksGuidance}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding SelectedClickFlow.StepsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                         VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Grid>

            <!-- Remember -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVis}, ConverterParameter=RememberStuff}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox Content="Save past results? (adds a History screen)"
                          IsChecked="{Binding SavePastResults}" Margin="0" FontSize="15"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox Content="Include a settings screen?"
                          IsChecked="{Binding IncludeSettingsScreen}" Margin="0" FontSize="15"/>
                <Border Style="{DynamicResource OptionalBadge}"><TextBlock Style="{DynamicResource OptionalBadgeText}"/></Border>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="Leave both off for a simple app. You can always change this later — History and Settings only appear when you turn them on."/>
            </StackPanel>

            <!-- Blueprint hub -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVis}, ConverterParameter=HandOff}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Background="{DynamicResource InnerCardBackgroundBrush}" BorderBrush="{DynamicResource InnerCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding HubProgressCaption}" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{DynamicResource TealBrush}"/>
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding HubReadyPercent}" Margin="0,8,0,0"
                                 Foreground="{DynamicResource CoralBrush}" Background="{DynamicResource SandDeepBrush}"/>
                    <TextBlock Margin="0,10,0,4" FontSize="13" Text="Detail level"/>
                    <ComboBox ItemsSource="{Binding DetailLevelOptions}"
                              SelectedItem="{Binding SelectedDetailLevelLabel}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"
                               Text="Simple hides tech details. Standard shows the stack. Expert lets you edit theme and navigation."/>
                  </StackPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Sections" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ListBox ItemsSource="{Binding HubSections}" SelectedItem="{Binding SelectedHubSection}"
                           BorderThickness="0" Background="Transparent"
                           MouseDoubleClick="HubSection_OnDoubleClick">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold" Margin="0,0,8,0"
                                       Foreground="{Binding Status, Converter={StaticResource HubStatusBrush}}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="18,2,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <StackPanel Grid.Column="2">
                <TextBlock Text="App Blueprint Artifacts &amp; Story" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TabControl SelectedIndex="{Binding SelectedArtifactTabIndex}" Margin="0,0,0,12" MinHeight="160" MaxHeight="320">
                  <TabItem Header="App Story">
                    <TextBox Text="{Binding AppStory}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="4" Background="{DynamicResource InnerCardBackgroundBrush}" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                  </TabItem>
                  <TabItem Header="Blueprint JSON">
                    <TextBox Text="{Binding BlueprintJsonPreview}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="4" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InnerCardBackgroundBrush}" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                  </TabItem>
                  <TabItem Header="AGENTS.md">
                    <TextBox Text="{Binding AgentsMdPreview}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="4" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InnerCardBackgroundBrush}" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                  </TabItem>
                  <TabItem Header="Specifications">
                    <TextBox Text="{Binding SpecificationsPreview}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="4" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InnerCardBackgroundBrush}" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                  </TabItem>
                  <TabItem Header="Tasks">
                    <TextBox Text="{Binding TasksPreview}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="4" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InnerCardBackgroundBrush}" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                  </TabItem>
                </TabControl>

                <StackPanel Visibility="{Binding ShowStandardDetails, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                  <TextBlock Text="Technology summary" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <TextBox Text="{Binding TechSummary}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                           MinHeight="90" Background="{DynamicResource InnerCardBackgroundBrush}" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowExpertDetails, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                  <TextBlock Text="Expert overrides" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="Theme"/>
                      <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Answers.Theme}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="Navigation"/>
                      <ComboBox ItemsSource="{Binding NavigationOptions}" SelectedItem="{Binding Answers.NavigationPattern}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="UI framework"/>
                      <TextBox Text="{Binding Answers.UiFramework, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="Language"/>
                      <TextBox Text="{Binding Answers.Language, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="Architecture decision"/>
                      <ComboBox ItemsSource="{Binding DecisionModeOptions}" SelectedItem="{Binding SelectedArchitectureDecisionLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Style="{DynamicResource FieldLabel}" Text="Storage decision"/>
                      <ComboBox ItemsSource="{Binding DecisionModeOptions}" SelectedItem="{Binding SelectedStorageDecisionLabel}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="Recommendations" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <TextBlock Text="Deterministic suggestions with a Why? — not AI. Use Detail level Standard/Expert for tech summary and overrides."
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource InnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8" Background="{DynamicResource CardBrush}">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                              <Button Content="Why?" Command="{Binding DataContext.ExplainRecommendationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" Style="{DynamicResource GhostButton}" Padding="10,4" Margin="0,0,6,0"/>
                              <Button Content="Use" Command="{Binding DataContext.ApplyRecommendationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" Style="{DynamicResource SecondaryButton}" Padding="10,4"
                                      IsEnabled="{Binding CanApply}"/>
                            </StackPanel>
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding SuggestedValue, Mode=OneWay}" Foreground="{DynamicResource TealBrush}"/>
                              </TextBlock>
                              <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                              <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" FontSize="12"/>
                              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"
                                         Text="{Binding RuleId, StringFormat=Rule: {0}}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding HandOffGuidance}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ReadySummary}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="14"/>
                <ItemsControl ItemsSource="{Binding ReadyMessages}" Margin="0,0,0,16">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource CoralBrush}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Initialize Git repository and initial commit when exporting Agent Package"
                          IsChecked="{Binding InitializeGitOnExport}" Margin="0,0,0,10" FontWeight="SemiBold"/>
                <WrapPanel>
                  <Button Content="Check again" Command="{Binding RunReadyCheckCommand}" Style="{DynamicResource GhostButton}" Margin="0,0,10,8"/>
                  <Button Content="Edit selected section" Command="{Binding JumpToHubSectionCommand}"
                          CommandParameter="{Binding SelectedHubSection}"
                          Style="{DynamicResource GhostButton}" Margin="0,0,10,8"/>
                  <Button Content="Copy Kickoff Prompt" Command="{Binding CopyKickoffPromptCommand}" Style="{DynamicResource GhostButton}" Margin="0,0,10,8"
                          ToolTip="Copy ready-to-run prompt for Claude / Cursor / Gemini"/>
                  <Button Content="Save App Blueprint" Command="{Binding SaveDocumentCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"
                          IsEnabled="{Binding IsReadyToExport}"/>
                  <Button Content="Export for AI agent" Command="{Binding ExportJsonCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8"
                          IsEnabled="{Binding IsReadyToExport}"/>
                  <Button Content="Export Agent Package" Command="{Binding ExportAgentPackageCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"
                          IsEnabled="{Binding IsReadyToExport}"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
  </Border>
</Window>
